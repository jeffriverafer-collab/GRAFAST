<!-- ===== HEADER / NAV ===== -->
<header class="header" id="header">
  <div class="container header__inner">
    <a href="{{ rutaInicio }}#inicio" class="logo">
      <img src="img/logo/grafast-logo-mark.png" alt="Grafast">
    </a>

    <nav class="nav" id="nav">
      <ul class="nav__list">
        <li><a href="{{ rutaInicio }}#inicio" class="nav__link{% if pagina == 'inicio' %} active{% endif %}">Inicio</a></li>
        <li><a href="{{ rutaInicio }}#nosotros" class="nav__link">Nosotros</a></li>
        <li><a href="servicios.html" class="nav__link{% if pagina == 'servicios' %} active{% endif %}">Servicios</a></li>
        <li class="has-dropdown">
          <a href="{{ '#productos' if pagina == 'inicio' else 'productos.html' }}" class="nav__link{% if pagina == 'productos' %} active{% endif %}">Productos <i class="fa-solid fa-chevron-down"></i></a>
          <div class="dropdown">
            {%- for cat in catalogo %}
            <div class="dropdown__col">
              <a href="{{ rutaCatalogo }}#{{ cat.id }}" class="dropdown__title"><i class="fa-solid {{ cat.icono }}"></i> {{ cat.nombre }}</a>
              <ul>
                {%- for p in cat.productos %}
                <li><a href="{{ rutaCatalogo }}#{{ cat.id }}">{{ p.nombre }}</a></li>
                {%- endfor %}
              </ul>
              {%- if loop.last %}
              <a href="productos.html" class="dropdown__all">Ver catálogo completo →</a>
              {%- endif %}
            </div>
            {%- endfor %}
          </div>
        </li>
        <li><a href="{{ rutaInicio }}#proyectos" class="nav__link">Proyectos</a></li>
        <li><a href="{{ rutaInicio }}#contacto" class="nav__link">Contacto</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <div class="header__contact-icons">
        <a href="{{ '' | whatsapp }}" target="_blank" rel="noopener" class="icon-btn icon-btn--whatsapp" aria-label="WhatsApp">
          <i class="fa-brands fa-whatsapp"></i>
        </a>
        <a href="tel:{{ contacto.telefono }}" class="icon-btn icon-btn--phone" aria-label="Llamar">
          <i class="fa-solid fa-phone"></i>
        </a>
        <a href="#" class="icon-btn icon-btn--mail js-email-link" data-user="{{ contacto.emailUsuario }}" data-domain="{{ contacto.emailDominio }}" aria-label="Correo">
          <i class="fa-solid fa-envelope"></i>
        </a>
        <noscript><a href="mailto:{{ contacto.emailUsuario }}@{{ contacto.emailDominio }}" class="icon-btn icon-btn--mail" aria-label="Correo"><i class="fa-solid fa-envelope"></i></a></noscript>
      </div>
      <button class="nav__toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
