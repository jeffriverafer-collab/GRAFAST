<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">

<link rel="icon" href="favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">

<link rel="stylesheet" href="css/style.css">
</head>
<body data-whatsapp="{{ contacto.whatsapp }}">

{#- Prefijos de enlace: en su propia página los anclas son locales (#seccion),
    en las demás apuntan a la página correspondiente (index.html#seccion). -#}
{%- set rutaInicio = "" if pagina == "inicio" else "index.html" -%}
{%- set rutaCatalogo = "" if pagina == "productos" else "productos.html" -%}

{% include "header.njk" %}

{{ content | safe }}

{% include "footer.njk" %}

<button id="backToTop" class="back-to-top" aria-label="Volver arriba"><i class="fa-solid fa-arrow-up"></i></button>

{% if pagina == "inicio" %}
{% include "redes-flotantes.njk" %}
{% include "album.njk" %}
{% endif %}

<script type="module" src="js/main.js"></script>
</body>
</html>
