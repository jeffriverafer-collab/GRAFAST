<!-- Álbum de fotos de un proyecto realizado -->
<div id="album" class="album-overlay">
  <div class="album-contenido">
    <span class="cerrar" id="albumCerrar">&times;</span>

    <img id="imagenAlbum" src="" alt="Foto del proyecto">
    <p class="album-titulo" id="albumTitulo"></p>

    <button class="anterior" id="albumAnterior" aria-label="Foto anterior">&#10094;</button>
    <button class="siguiente" id="albumSiguiente" aria-label="Foto siguiente">&#10095;</button>

    <div class="miniaturas" id="albumMiniaturas"></div>
  </div>
</div>
