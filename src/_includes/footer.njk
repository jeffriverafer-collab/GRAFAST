<!-- ===== FOOTER ===== -->
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__col footer__logo">
      <img src="img/logo/grafast-logo.png" alt="Grafast">
      <p>{{ footerDescripcion or "Soluciones en impermeabilización y techado de alto rendimiento para proyectos residenciales, industriales y logísticos en todo el Perú." }}</p>
      <div class="footer__social">
        <a href="{{ contacto.redes.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="{{ contacto.redes.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
      </div>
    </div>
    <div class="footer__col">
      <h4>Enlaces</h4>
      <ul>
        <li><a href="{{ rutaInicio }}#inicio">Inicio</a></li>
        <li><a href="{{ rutaInicio }}#nosotros">Nosotros</a></li>
        <li><a href="servicios.html">Servicios</a></li>
        <li><a href="{{ '#productos' if pagina == 'inicio' else 'productos.html' }}">Productos</a></li>
        <li><a href="{{ rutaInicio }}#proyectos">Proyectos</a></li>
        <li><a href="{{ rutaInicio }}#contacto">Contacto</a></li>
      </ul>
    </div>
    <div class="footer__col">
      {%- if pagina == "servicios" %}
      <h4>Servicios</h4>
      <ul>
        {%- for cat in servicios %}
        <li><a href="#{{ cat.id }}">{{ cat.nombre }}</a></li>
        {%- endfor %}
        <li><a href="productos.html">Ver Productos</a></li>
      </ul>
      {%- else %}
      <h4>{{ "Categorías" if pagina == "productos" else "Productos" }}</h4>
      <ul>
        {%- for cat in catalogo %}
        <li><a href="{{ rutaCatalogo }}#{{ cat.id }}">{{ cat.nombre }}</a></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
    <div class="footer__col">
      <h4>Boletín</h4>
      <p>Recibe novedades y consejos técnicos sobre impermeabilización.</p>
      <form class="footer__newsletter" id="newsletterForm">
        <input type="email" placeholder="Tu correo electrónico" required>
        <button type="submit" aria-label="Suscribirse"><i class="fa-solid fa-paper-plane"></i></button>
      </form>
    </div>
  </div>
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; <span id="year"></span> Grafast Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
